# Wix Dashboard > Settings > Development & integrations > Headless Settings
WIX_CLIENT_ID=

# Wix Dashboard > Customers & Leads > Forms & Submissions
# Run `npm run wix:forms` to list form IDs and field targets.
WIX_NEWSLETTER_FORM_ID=
WIX_MAKER_FORM_ID=
WIX_POPUP_FORM_ID=
WIX_HOST_FORM_ID=

# Google Cloud console > APIs & Services > Credentials. Enable Places API (New)
# and restrict the key to it. Shows the Google Business Profile hours on the
# home page; without it the visit section links out instead.
GOOGLE_PLACES_API_KEY=
