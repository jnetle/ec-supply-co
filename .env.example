# Wix Dashboard > Settings > Development & integrations > Headless Settings
WIX_CLIENT_ID=

# Wix Dashboard > Customers & Leads > Forms & Submissions
# Run `npm run wix:forms` to list form IDs and field targets.
WIX_NEWSLETTER_FORM_ID=
WIX_MAKER_FORM_ID=
WIX_POPUP_FORM_ID=
WIX_HOST_FORM_ID=

# Wix Dashboard > Settings > API Keys, with the Wix Events permission. Acts as
# the site owner (reads guest lists to catch repeat RSVPs), so it stays
# server-only. The site ID is the part after /dashboard/ in the dashboard URL.
WIX_API_KEY=
WIX_SITE_ID=

# Google Cloud console > APIs & Services > Credentials. Enable Places API (New)
# and restrict the key to it. Shows the Google Business Profile hours on the
# home page; without it the visit section links out instead.
GOOGLE_PLACES_API_KEY=

# Google Calendar > Settings for the shop calendar > Integrate calendar >
# Secret address in iCal format. Open shifts and bookings both count as busy;
# /host-with-us shows the gaps between them. Only free times reach visitors.
# Server-only: anyone with this address can read the whole calendar.
GOOGLE_CALENDAR_ICS_URL=
